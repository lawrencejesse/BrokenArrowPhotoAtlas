# Apply only to a SEPARATE preview Replit app. Production keeps its .replit.
entrypoint = "index.html"
modules = ["web", "nodejs-20"]
run = "npm run preview"

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "preview"]

[userenv]
[userenv.shared]
PREVIEW_HOST = "0.0.0.0"
PORT = "5000"

[[ports]]
localPort = 5000
externalPort = 80
